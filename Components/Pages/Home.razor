@page "/"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>PR beats</PageTitle>

@{
    string? activeImageUrl = null;
    string? coverDiagnostic = null;
    var coverAlt = "";
    if (_slides.Count > 0)
    {
        var activeRow = _slides[_activeIndex];
        coverAlt = string.IsNullOrWhiteSpace(activeRow.GameTitle)
            ? "Untitled"
            : activeRow.GameTitle.Trim();
        var rowImage = activeRow.GameImage?.Trim() ?? "";
        var sharedImage = GameImageForTitle(coverAlt);
        if (!string.IsNullOrWhiteSpace(rowImage))
        {
            activeImageUrl = rowImage;
        }
        else if (!string.IsNullOrWhiteSpace(sharedImage))
        {
            // Same behavior as Admin: cover is per-game, not per-announcement.
            activeImageUrl = sharedImage;
        }
        else
        {
            coverDiagnostic =
                $"No cover image found for “{coverAlt}”. " +
                "This announcement’s gameImage field is empty in the API, " +
                "and no other announcement for this game has one either. " +
                "Re-upload the cover in Admin (game settings) and wait for Save to finish.";
        }
    }
    var hasCover = !string.IsNullOrWhiteSpace(activeImageUrl) && string.IsNullOrWhiteSpace(_coverLoadError);
    var coverErrorText = !string.IsNullOrWhiteSpace(_coverLoadError)
        ? _coverLoadError
        : coverDiagnostic;
}

<div class="public-app @(_showGate ? "is-gate" : null)">
    @if (_showGate)
    {
        <div class="public-gate">
            <img
                class="public-gate-icon"
                src="images/SilverLiningIcon.png"
                alt="Silver Lining"
                width="176"
                height="176" />
            <h1 class="public-gate-brand">Silver Lining PR Beats</h1>
            <p class="public-gate-lede">Get in contact to request a key for the tool.</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(_status))
    {
        <p class="note @(_isError ? "is-error" : null)">@_status</p>
    }

    @if (!_showGate && _slides.Count > 0)
    {
        var active = _slides[_activeIndex];
        var gameTitle = string.IsNullOrWhiteSpace(active.GameTitle)
            ? "Untitled"
            : active.GameTitle.Trim();
        var announcementTitle = active.AnnouncementTitle?.Trim() ?? "";
        var entries = new[] { active };
        <div class="announcement-carousel is-ready"
             tabindex="0"
             @onkeydown="OnKeyDown"
             @ontouchstart="OnTouchStart"
             @ontouchend="OnTouchEnd">
            <div class="carousel-dots" role="tablist" aria-label="Announcements">
                @for (var i = 0; i < _slides.Count; i++)
                {
                    var index = i;
                    var isActive = index == _activeIndex;
                    var slide = _slides[index];
                    var slideGame = string.IsNullOrWhiteSpace(slide.GameTitle)
                        ? "Untitled"
                        : slide.GameTitle.Trim();
                    var slideAnnouncement = slide.AnnouncementTitle?.Trim() ?? "";
                    var slideLabel = string.IsNullOrWhiteSpace(slideAnnouncement)
                        ? slideGame
                        : $"{slideGame}: {slideAnnouncement}";
                    if (index > 0)
                    {
                        var prevGame = string.IsNullOrWhiteSpace(_slides[index - 1].GameTitle)
                            ? "Untitled"
                            : _slides[index - 1].GameTitle.Trim();
                        if (!string.Equals(prevGame, slideGame, StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="carousel-dot-separator" aria-hidden="true"></span>
                        }
                    }
                    <button type="button"
                            class="carousel-dot @(isActive ? "is-active" : null)"
                            role="tab"
                            aria-selected="@isActive"
                            aria-label="@slideLabel"
                            tabindex="@(isActive ? 0 : -1)"
                            @onclick="() => ShowSlideAsync(index)">
                    </button>
                }
            </div>

            <div class="cover-banner @(hasCover ? null : "is-empty")" aria-hidden="@(hasCover ? "false" : "true")">
                @if (!string.IsNullOrWhiteSpace(activeImageUrl) && string.IsNullOrWhiteSpace(_coverLoadError))
                {
                    <img class="carousel-game-image"
                         src="@activeImageUrl"
                         alt="@coverAlt"
                         @onerror="OnCoverImageError" />
                }
                else
                {
                    <span class="cover-banner-placeholder">Cover image</span>
                    @if (!string.IsNullOrWhiteSpace(coverErrorText))
                    {
                        <p class="cover-banner-error" role="alert">@coverErrorText</p>
                    }
                }
            </div>

            <div class="carousel-slide" @key="_activeIndex" aria-live="polite">
                <h2 class="carousel-game">@gameTitle</h2>
                @if (!string.IsNullOrWhiteSpace(announcementTitle))
                {
                    <p class="carousel-subtitle">@announcementTitle</p>
                }
                <div class="detail-cards detail-cards-row" @ref="_detailCardsRef">
                    <section class="detail-card detail-card-platforms" @ref="_platformsCardRef">
                        <h3 class="detail-card-label">Platforms</h3>
                        @{
                            var platforms = PlatformsForEntries(entries);
                        }
                        <div class="platform-chips readonly @(platforms.Count == 0 ? "muted" : null)">
                            @if (platforms.Count == 0)
                            {
                                <span style="font-style: italic; opacity: 0.45;">No platforms</span>
                            }
                            else
                            {
                                @foreach (var platform in platforms)
                                {
                                    <div class="platform-entry">
                                        <img class="platform-icon" src="@platform.Icon" alt="" @onload="OnPlatformIconLoad" />
                                        <span class="platform-name">@platform.Label</span>
                                    </div>
                                }
                            }
                        </div>
                    </section>
                    <section class="detail-card">
                        <h3 class="detail-card-label">Date</h3>
                        <ul class="detail-card-list">
                            @{
                                var date = string.IsNullOrWhiteSpace(active.Date)
                                    ? "No date"
                                    : active.Date.Trim();
                            }
                            <li class="@(string.IsNullOrWhiteSpace(active.Date) ? "is-empty" : null)">
                                @date
                            </li>
                        </ul>
                    </section>
                    <section class="detail-card">
                        <h3 class="detail-card-label">Estimated reach</h3>
                        <ul class="detail-card-list">
                            @{
                                var reach = string.IsNullOrWhiteSpace(active.EstimatedReach)
                                    ? "No data"
                                    : active.EstimatedReach.Trim();
                            }
                            <li class="@(string.IsNullOrWhiteSpace(active.EstimatedReach) ? "is-empty" : null)">
                                @reach
                            </li>
                        </ul>
                    </section>
                    @if (HasWishlistData(active.TotalWishlists))
                    {
                        <section class="detail-card detail-card-wishlists">
                            <h3 class="detail-card-label">Total wishlists</h3>
                            <ul class="detail-card-list">
                                <li>@active.TotalWishlists!.Trim()</li>
                            </ul>
                        </section>
                    }
                </div>

                @{
                    var trailerEmbed = YoutubeEmbedUrl(active.Trailer);
                    var pdfFull = PdfEmbedUrl(active.PressReleasePdf, toolbar: true);
                    var pdfEmbed = PdfEmbedUrl(active.PressReleasePdf, toolbar: false);
                }
                <div class="media-cards">
                    <section class="trailer-card @(string.IsNullOrWhiteSpace(trailerEmbed) ? "is-empty" : null)" aria-label="Trailer">
                        <h3 class="detail-card-label">Trailer</h3>
                        <div class="trailer-embed">
                            @if (!string.IsNullOrWhiteSpace(trailerEmbed))
                            {
                                <iframe src="@trailerEmbed"
                                        title="Game trailer"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                        allowfullscreen
                                        referrerpolicy="strict-origin-when-cross-origin"></iframe>
                            }
                            else
                            {
                                <span class="trailer-placeholder">No trailer</span>
                            }
                        </div>
                    </section>

                    <section class="trailer-card pdf-card @(string.IsNullOrWhiteSpace(pdfEmbed) ? "is-empty" : null)" aria-label="Press release PDF">
                        <div class="media-card-heading">
                            <h3 class="detail-card-label">Press release PDF</h3>
                            @if (!string.IsNullOrWhiteSpace(pdfFull))
                            {
                                <button type="button"
                                        class="btn-ghost media-expand-btn"
                                        aria-label="Expand PDF"
                                        title="Expand PDF"
                                        @onclick="() => OpenPdfViewer(pdfFull)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M15 3h6v6" />
                                        <path d="m21 3-7 7" />
                                        <path d="m3 21 7-7" />
                                        <path d="M3 15v6h6" />
                                    </svg>
                                </button>
                            }
                        </div>
                        <div class="trailer-embed">
                            @if (!string.IsNullOrWhiteSpace(pdfEmbed))
                            {
                                <iframe class="pdf-preview-frame"
                                        src="@pdfEmbed"
                                        title="Press release PDF"
                                        allow="fullscreen"
                                        allowfullscreen></iframe>
                            }
                            else
                            {
                                <span class="trailer-placeholder">No PDF</span>
                            }
                        </div>
                    </section>
                </div>

                @{
                    var coverageLinks = CoverageLinksForEntries(entries);
                }
                <section class="coverage-links-section" aria-labelledby="coverage-links-heading">
                    <h3 class="detail-card-label coverage-links-heading" id="coverage-links-heading">Campaign Coverage</h3>
                    <div class="coverage-links-panel">
                    <div class="coverage-links-grid">
                        @if (coverageLinks.Count == 0)
                        {
                            <p class="coverage-links-empty">No coverage links</p>
                        }
                        else
                        {
                            @foreach (var link in coverageLinks)
                            {
                                var outletName = !string.IsNullOrWhiteSpace(link.OutletName)
                                    ? link.OutletName
                                    : LinkLabel(link.Url);
                                var articleTitle = !string.IsNullOrWhiteSpace(link.Title)
                                    ? link.Title
                                    : outletName;
                                var flagUrl = CountryFlagUrl(link.OutletCountry);
                                var statsText = FormatCoverageStat(link.OutletStats);
                                <a class="coverage-link"
                                   href="@link.Url"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    <p class="coverage-link-outlet">@outletName</p>
                                    <div class="coverage-link-cover @(!string.IsNullOrWhiteSpace(link.CoverImage) ? null : "is-favicon")">
                                        @if (!string.IsNullOrWhiteSpace(link.CoverImage))
                                        {
                                            <img class="coverage-link-cover-image" src="@link.CoverImage" alt="" referrerpolicy="no-referrer" />
                                        }
                                        else
                                        {
                                            <img class="coverage-link-cover-image" src="@FaviconUrl(link.Url)" alt="" referrerpolicy="no-referrer" />
                                            <span class="coverage-link-cover-empty" hidden>No cover</span>
                                        }
                                    </div>
                                    <p class="coverage-link-title">@articleTitle</p>
                                    @if (!string.IsNullOrWhiteSpace(link.OutletCountry) || !string.IsNullOrWhiteSpace(statsText))
                                    {
                                        <div class="coverage-link-footer">
                                            @if (!string.IsNullOrWhiteSpace(link.OutletCountry))
                                            {
                                                <div class="coverage-link-stat">
                                                    <span class="coverage-link-stat-label">Country</span>
                                                    <div class="coverage-link-country-value">
                                                        @if (!string.IsNullOrWhiteSpace(flagUrl))
                                                        {
                                                            <div class="coverage-link-flag" title="@link.OutletCountry">
                                                                <img src="@flagUrl" alt="@link.OutletCountry" loading="lazy" referrerpolicy="no-referrer" />
                                                            </div>
                                                        }
                                                        <span class="coverage-link-stat-value">@link.OutletCountry</span>
                                                    </div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(statsText))
                                            {
                                                <div class="coverage-link-stat">
                                                    <span class="coverage-link-stat-label">Outlet stats</span>
                                                    <span class="coverage-link-stat-value">@statsText</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </a>
                            }
                        }
                    </div>
                    </div>
                </section>

                <section class="coverage-links-section media-coverage-summary-section-public"
                         aria-labelledby="media-coverage-summary-heading">
                    <h3 class="detail-card-label coverage-links-heading" id="media-coverage-summary-heading">
                        Media Coverage
                    </h3>
                    @if (!string.IsNullOrWhiteSpace(_mediaCoverageStatus))
                    {
                        <p class="media-coverage-summary-status @(_mediaCoverageStatusError ? "is-error" : null)">
                            @_mediaCoverageStatus
                        </p>
                    }
                    <div class="media-coverage-summary-public-wrap">
                        <div class="media-coverage-stat-board">
                            <div class="media-coverage-stat-row media-coverage-stat-row-featured">
                                @foreach (var card in _mediaCoverageCards.Where(c => c.Featured))
                                {
                                    <article class="media-coverage-stat-card is-featured">
                                        @{
                                            var featuredIcon = MediaCoveragePlatformIconSrc(card.Platform);
                                        }
                                        @if (!string.IsNullOrWhiteSpace(featuredIcon))
                                        {
                                            <span class="media-coverage-stat-icon is-@card.Platform" aria-hidden="true" title="@card.Label">
                                                <img src="@featuredIcon" alt="" loading="lazy" decoding="async" />
                                            </span>
                                        }
                                        <p class="media-coverage-stat-value">@card.Value</p>
                                        <h4 class="media-coverage-stat-label">@card.Label</h4>
                                        <p class="media-coverage-stat-hint">@card.Hint</p>
                                    </article>
                                }
                            </div>
                            @foreach (var platform in MediaCoverageStatPlatformOrder)
                            {
                                var platformCards = _mediaCoverageCards
                                    .Where(c => !c.Featured
                                        && string.Equals(c.Platform, platform.Id, StringComparison.OrdinalIgnoreCase))
                                    .ToList();
                                if (platformCards.Count == 0) continue;
                                <section class="media-coverage-stat-platform" data-platform="@platform.Id">
                                    <h4 class="media-coverage-stat-platform-title">@platform.Label</h4>
                                    <div class="media-coverage-stat-grid">
                                        @foreach (var card in platformCards)
                                        {
                                            <article class="media-coverage-stat-card">
                                                @{
                                                    var iconSrc = MediaCoveragePlatformIconSrc(card.Platform);
                                                }
                                                @if (!string.IsNullOrWhiteSpace(iconSrc))
                                                {
                                                    <span class="media-coverage-stat-icon is-@card.Platform" aria-hidden="true" title="@card.Label">
                                                        <img src="@iconSrc" alt="" loading="lazy" decoding="async" />
                                                    </span>
                                                }
                                                <p class="media-coverage-stat-value">@card.Value</p>
                                                <h4 class="media-coverage-stat-label">@card.Label</h4>
                                                <p class="media-coverage-stat-hint">@card.Hint</p>
                                            </article>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                </section>
            </div>
        </div>
    }
</div>

@if (_pdfViewerOpen && !string.IsNullOrWhiteSpace(_pdfViewerUrl))
{
    <div class="pdf-viewer-overlay"
         role="dialog"
         aria-modal="true"
         aria-labelledby="pdf-viewer-title"
         tabindex="-1"
         @onkeydown="OnPdfViewerKeyDown"
         @onclick="ClosePdfViewer">
        <div class="pdf-viewer-panel" @onclick:stopPropagation="true">
            <header class="pdf-viewer-header">
                <h2 id="pdf-viewer-title">Press release PDF</h2>
                <button type="button" class="btn-ghost" @onclick="ClosePdfViewer">Close</button>
            </header>
            <div class="pdf-viewer-frame">
                <iframe src="@_pdfViewerUrl"
                        title="Press release PDF"
                        allow="fullscreen"
                        allowfullscreen></iframe>
            </div>
        </div>
    </div>
}

<a class="admin-link" href="/admin">Admin</a>

@code {
    private const string ApiBase = "https://prbeats.matthew-d60.workers.dev";

    private string _status = "Loading…";
    private bool _isError;
    private bool _showGate;
    private int _activeIndex;
    private double _touchStartX;
    private bool _pdfViewerOpen;
    private string? _pdfViewerUrl;
    private List<AnnouncementRow> _slides = [];
    private ElementReference _detailCardsRef;
    private ElementReference _platformsCardRef;
    private bool _detailCardsWatchReady;
    private string? _coverLoadError;
    private string? _coverLoadAttemptUrl;
    private List<MediaCoverageStatCard> _mediaCoverageCards = BuildMediaCoverageCards([]);
    private string _mediaCoverageStatus = "";
    private bool _mediaCoverageStatusError;
    private string? _mediaCoverageLoadedForGame;
    private readonly Dictionary<string, string> _mediaCoverageCache = new(StringComparer.OrdinalIgnoreCase);
    private int _mediaCoverageLoadToken;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showGate || _slides.Count == 0) return;
        await SyncDetailCardHeightsAsync(setupWatch: firstRender || !_detailCardsWatchReady);
    }

    private async Task SyncDetailCardHeightsAsync(bool setupWatch = false)
    {
        try
        {
            if (setupWatch || !_detailCardsWatchReady)
            {
                await JS.InvokeVoidAsync(
                    "prbeatsWatchDetailCardHeights",
                    _detailCardsRef,
                    _platformsCardRef);
                _detailCardsWatchReady = true;
            }
            else
            {
                await JS.InvokeVoidAsync(
                    "prbeatsSyncDetailCardHeights",
                    _detailCardsRef,
                    _platformsCardRef);
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
        catch (InvalidOperationException)
        {
            // JS not ready yet on first paint.
        }
        catch (JSException)
        {
            // Script may not be loaded yet; retry next render.
            _detailCardsWatchReady = false;
        }
    }

    private async Task OnPlatformIconLoad()
    {
        await SyncDetailCardHeightsAsync();
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = uri.Query;
            if (string.IsNullOrWhiteSpace(query) || query == "?")
            {
                _showGate = true;
                _status = "";
                return;
            }

            var apiUrl = $"{ApiBase}/api/public/announcements{query}";

            var data = await Http.GetFromJsonAsync<PublicDataset>(
                apiUrl,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            var rows = data?.Rows ?? [];

            if (rows.Count == 0)
            {
                _status = "No announcements match this filter.";
                return;
            }

            _slides = rows
                .OrderBy(row => string.IsNullOrWhiteSpace(row.GameTitle) ? "Untitled" : row.GameTitle.Trim(),
                    StringComparer.OrdinalIgnoreCase)
                .ThenBy(row => row.AnnouncementTitle?.Trim() ?? "", StringComparer.OrdinalIgnoreCase)
                .ToList();

            _status = "";
            await EnsureMediaCoverageForActiveSlideAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _status = $"Could not load announcements: {ex.Message}";
        }
    }

    private Task ShowSlideAsync(int index) => ShowSlide(index);

    private async Task ShowSlide(int index)
    {
        if (_slides.Count == 0) return;
        ClosePdfViewer();
        _activeIndex = ((index % _slides.Count) + _slides.Count) % _slides.Count;
        _detailCardsWatchReady = false;
        _coverLoadError = null;
        _coverLoadAttemptUrl = null;
        await EnsureMediaCoverageForActiveSlideAsync();
    }

    private async Task EnsureMediaCoverageForActiveSlideAsync()
    {
        if (_slides.Count == 0) return;
        var active = _slides[_activeIndex];
        var gameTitle = string.IsNullOrWhiteSpace(active.GameTitle)
            ? "Untitled"
            : active.GameTitle.Trim();

        // Per-game cache: every Witch's Bakery slide shows the same game totals.
        if (_mediaCoverageCache.TryGetValue(gameTitle, out var cachedJson))
        {
            _mediaCoverageLoadedForGame = gameTitle;
            ApplyMediaCoverageJson(cachedJson);
            return;
        }

        if (string.Equals(_mediaCoverageLoadedForGame, gameTitle, StringComparison.OrdinalIgnoreCase)
            && _mediaCoverageCards.Count > 0
            && string.IsNullOrWhiteSpace(_mediaCoverageStatus))
        {
            return;
        }

        var token = ++_mediaCoverageLoadToken;
        _mediaCoverageLoadedForGame = gameTitle;
        _mediaCoverageStatusError = false;

        // Prefer the dedicated per-game API over any announcement-embedded copy.
        _mediaCoverageStatus = "Loading media coverage…";
        _mediaCoverageCards = BuildMediaCoverageCards([]);
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var shareSuffix = "";
            foreach (var part in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var eq = part.IndexOf('=');
                var key = eq >= 0 ? part[..eq] : part;
                if (!string.Equals(Uri.UnescapeDataString(key), "s", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }
                var value = eq >= 0 ? Uri.UnescapeDataString(part[(eq + 1)..]) : "";
                if (!string.IsNullOrWhiteSpace(value))
                {
                    shareSuffix = "&s=" + Uri.EscapeDataString(value.Trim());
                }
                break;
            }
            var apiUrl =
                $"{ApiBase}/api/public/media-coverage?game={Uri.EscapeDataString(gameTitle)}{shareSuffix}";

            using var response = await Http.GetAsync(apiUrl);
            if (token != _mediaCoverageLoadToken) return;
            if (!response.IsSuccessStatusCode)
            {
                // Fall back to any coverage embedded on announcement rows for this game.
                var embedded = "";
                foreach (var row in _slides)
                {
                    var title = string.IsNullOrWhiteSpace(row.GameTitle) ? "Untitled" : row.GameTitle.Trim();
                    if (!string.Equals(title, gameTitle, StringComparison.OrdinalIgnoreCase)) continue;
                    embedded = row.MediaCoverage?.Trim() ?? "";
                    if (!string.IsNullOrWhiteSpace(embedded)) break;
                }
                if (!string.IsNullOrWhiteSpace(embedded))
                {
                    _mediaCoverageCache[gameTitle] = embedded;
                    ApplyMediaCoverageJson(embedded);
                    return;
                }

                _mediaCoverageStatusError = true;
                _mediaCoverageStatus = response.StatusCode == System.Net.HttpStatusCode.NotFound
                    ? "Media coverage API not available yet."
                    : $"Could not load media coverage ({(int)response.StatusCode}).";
                _mediaCoverageCards = BuildMediaCoverageCards([]);
                return;
            }

            var payload = await response.Content.ReadFromJsonAsync<MediaCoveragePublicPayload>(
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (token != _mediaCoverageLoadToken) return;
            var json = payload?.MediaCoverage?.Trim() ?? "";
            _mediaCoverageCache[gameTitle] = json;
            ApplyMediaCoverageJson(json);
        }
        catch (Exception ex)
        {
            if (token != _mediaCoverageLoadToken) return;
            _mediaCoverageStatusError = true;
            _mediaCoverageStatus = $"Could not load media coverage: {ex.Message}";
            _mediaCoverageCards = BuildMediaCoverageCards([]);
        }
    }

    private void ApplyMediaCoverageJson(string json)
    {
        var rows = ParseMediaCoverageRows(json);
        var overrides = ParseMediaCoverageSummaryOverrides(json);
        _mediaCoverageCards = BuildMediaCoverageCards(rows, overrides);
        _mediaCoverageStatus = rows.Count == 0 ? "No media coverage saved for this game yet." : "";
        _mediaCoverageStatusError = false;
    }

    private static Dictionary<string, string> ParseMediaCoverageSummaryOverrides(string? raw)
    {
        var text = (raw ?? "").Trim();
        if (string.IsNullOrWhiteSpace(text) || !text.StartsWith('{')) return new(StringComparer.Ordinal);
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(text);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object) return new(StringComparer.Ordinal);
            if (!doc.RootElement.TryGetProperty("summaryOverrides", out var overridesEl)
                || overridesEl.ValueKind != System.Text.Json.JsonValueKind.Object)
            {
                return new(StringComparer.Ordinal);
            }
            var result = new Dictionary<string, string>(StringComparer.Ordinal);
            foreach (var prop in overridesEl.EnumerateObject())
            {
                var id = prop.Name?.Trim() ?? "";
                var value = prop.Value.ValueKind switch
                {
                    System.Text.Json.JsonValueKind.String => prop.Value.GetString()?.Trim() ?? "",
                    System.Text.Json.JsonValueKind.Number => prop.Value.ToString(),
                    _ => "",
                };
                if (!string.IsNullOrWhiteSpace(id) && !string.IsNullOrWhiteSpace(value))
                    result[id] = value;
            }
            return result;
        }
        catch
        {
            return new(StringComparer.Ordinal);
        }
    }

    private static List<Dictionary<string, string>> ParseMediaCoverageRows(string? raw)
    {
        var text = (raw ?? "").Trim();
        if (string.IsNullOrWhiteSpace(text) || text is "[]" or "{}") return [];
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(text);
            System.Text.Json.JsonElement list = default;
            var hasList = false;
            if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                list = doc.RootElement;
                hasList = true;
            }
            else if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                // Worker stores { sectionTitle, rows: [...] } — same shape as admin/js.
                if (doc.RootElement.TryGetProperty("rows", out var rowsEl)
                    && rowsEl.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    list = rowsEl;
                    hasList = true;
                }
                else if (doc.RootElement.TryGetProperty("links", out var linksEl)
                    && linksEl.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    list = linksEl;
                    hasList = true;
                }
            }
            if (!hasList) return [];

            var rows = new List<Dictionary<string, string>>();
            foreach (var item in list.EnumerateArray())
            {
                if (item.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    var details = item.GetString()?.Trim() ?? "";
                    if (!string.IsNullOrWhiteSpace(details))
                    {
                        rows.Add(new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                        {
                            ["details"] = details,
                        });
                    }
                    continue;
                }
                if (item.ValueKind != System.Text.Json.JsonValueKind.Object) continue;
                var row = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                foreach (var prop in item.EnumerateObject())
                {
                    row[prop.Name] = prop.Value.ValueKind switch
                    {
                        System.Text.Json.JsonValueKind.String => prop.Value.GetString()?.Trim() ?? "",
                        System.Text.Json.JsonValueKind.Number => prop.Value.ToString(),
                        System.Text.Json.JsonValueKind.True => "true",
                        System.Text.Json.JsonValueKind.False => "false",
                        System.Text.Json.JsonValueKind.Null => "",
                        _ => prop.Value.ToString(),
                    };
                }
                if (row.Count > 0) rows.Add(row);
            }
            return rows;
        }
        catch
        {
            return [];
        }
    }

    private static string RowValue(Dictionary<string, string> row, string key) =>
        row.TryGetValue(key, out var value) ? value?.Trim() ?? "" : "";

    private static string MediaCoverageTypeKey(string? value) =>
        System.Text.RegularExpressions.Regex.Replace(
            System.Text.RegularExpressions.Regex.Replace(
                (value ?? "").Trim().ToLowerInvariant(),
                @"[_-]+",
                " "),
            @"\s+",
            " ");

    private static string MediaCoveragePlatformId(string? typeValue)
    {
        var key = MediaCoverageTypeKey(MediaCoverageTypeLabel(typeValue));
        if (key is "yt" or "youtube") return "youtube";
        if (key == "twitch") return "twitch";
        if (key is "tiktok" or "tik tok") return "tiktok";
        if (key is "instagram" or "ig") return "instagram";
        if (key is "bilibili" or "bili bili" or "bili") return "bilibili";
        return "";
    }

    private static string MediaCoverageTypeLabel(string? value)
    {
        var raw = (value ?? "").Trim();
        if (string.IsNullOrWhiteSpace(raw)) return "Other";
        var key = MediaCoverageTypeKey(raw);
        if (key is "yt" or "youtube") return "YouTube";
        if (key == "twitch") return "Twitch";
        if (key is "tiktok" or "tik tok") return "TikTok";
        if (key is "instagram" or "ig") return "Instagram";
        if (key is "bilibili" or "bili bili" or "bili") return "BiliBili";
        return raw;
    }

    private static bool IsPodcastRow(Dictionary<string, string> row)
    {
        var key = MediaCoverageTypeKey(RowValue(row, "type"));
        return key is "podcast" or "podcasts"
            || System.Text.RegularExpressions.Regex.IsMatch(key, @"\bpodcasts?\b");
    }

    private static double MediaCoverageMetricNumber(string? value)
    {
        var cleaned = (value ?? "").Trim().Replace(",", "");
        if (string.IsNullOrWhiteSpace(cleaned)) return 0;
        var match = System.Text.RegularExpressions.Regex.Match(cleaned, @"-?\d+(?:\.\d+)?");
        if (!match.Success) return 0;
        return double.TryParse(match.Value, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var n)
            ? n
            : 0;
    }

    private static string MediaCoverageCreatorIdentity(Dictionary<string, string> row)
    {
        var handleId = RowValue(row, "handleId").ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(handleId)) return $"id:{handleId}";
        var channel = RowValue(row, "youtubeChannelTitle").ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(channel)) return $"ch:{channel}";
        var twitch = RowValue(row, "twitchAccount").ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(twitch)) return $"tw:{twitch}";
        var name = RowValue(row, "customName").ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(name)) return $"name:{name}";
        var url = RowValue(row, "handleUrl").ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(url)) return $"url:{url}";
        return "";
    }

    private static int CountMediaCoverageCreators(IEnumerable<Dictionary<string, string>> rows)
    {
        var ids = new HashSet<string>(StringComparer.Ordinal);
        var anonymous = 0;
        foreach (var row in rows)
        {
            var identity = MediaCoverageCreatorIdentity(row);
            if (!string.IsNullOrWhiteSpace(identity)) ids.Add(identity);
            else anonymous += 1;
        }
        return ids.Count + anonymous;
    }

    private static double SumMediaCoverageField(IEnumerable<Dictionary<string, string>> rows, string key) =>
        rows.Sum(row => MediaCoverageMetricNumber(RowValue(row, key)));

    private static double UniqueCreatorFieldSum(IEnumerable<Dictionary<string, string>> rows, string field)
    {
        var byCreator = new Dictionary<string, double>(StringComparer.Ordinal);
        double anonymous = 0;
        foreach (var row in rows)
        {
            var identity = MediaCoverageCreatorIdentity(row);
            var value = MediaCoverageMetricNumber(RowValue(row, field));
            if (!string.IsNullOrWhiteSpace(identity))
            {
                if (!byCreator.TryGetValue(identity, out var prev) || value > prev)
                    byCreator[identity] = value;
            }
            else
            {
                anonymous += value;
            }
        }
        return anonymous + byCreator.Values.Sum();
    }

