    private static double OverrideOrComputed(
        IReadOnlyDictionary<string, string> overrides,
        string metricId,
        double computed)
    {
        if (overrides.TryGetValue(metricId, out var raw) && !string.IsNullOrWhiteSpace(raw))
            return MediaCoverageMetricNumber(raw);
        return computed;
    }

    private static List<MediaCoverageStatCard> BuildMediaCoverageCards(
        IReadOnlyList<Dictionary<string, string>> rows,
        IReadOnlyDictionary<string, string>? summaryOverrides = null)
    {
        static string Format(double value) =>
            ((long)Math.Round(Math.Max(0, value))).ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-US"));

        var overrides = summaryOverrides ?? new Dictionary<string, string>(StringComparer.Ordinal);
        var youtube = rows.Where(r => MediaCoveragePlatformId(RowValue(r, "type")) == "youtube").ToList();
        var tiktok = rows.Where(r => MediaCoveragePlatformId(RowValue(r, "type")) == "tiktok").ToList();
        var bilibili = rows.Where(r => MediaCoveragePlatformId(RowValue(r, "type")) == "bilibili").ToList();
        var instagram = rows.Where(r => MediaCoveragePlatformId(RowValue(r, "type")) == "instagram").ToList();
        var twitch = rows.Where(r => MediaCoveragePlatformId(RowValue(r, "type")) == "twitch").ToList();
        var podcasts = rows.Where(IsPodcastRow).ToList();

        var youtubeAudience = UniqueCreatorFieldSum(youtube, "youtubeSubs");
        var tiktokAudience = UniqueCreatorFieldSum(tiktok, "tiktokFollower");
        var twitchAudience = UniqueCreatorFieldSum(twitch, "twitchFollower");
        var effectiveYoutubeAudience = OverrideOrComputed(overrides, "youtube-audience", youtubeAudience);
        var totalAudience = effectiveYoutubeAudience + tiktokAudience + twitchAudience;
        totalAudience = OverrideOrComputed(overrides, "total-audience", totalAudience);

        var youtubeCoverages = (double)youtube.Count;
        var podcastCount = (double)podcasts.Count;
        var tiktokVideos = (double)tiktok.Count;
        var bilibiliVideos = (double)bilibili.Count;
        var instagramReels = (double)instagram.Count;
        var totalCoverages = (double)rows.Count
            - youtubeCoverages + OverrideOrComputed(overrides, "youtube-coverages", youtubeCoverages)
            - podcastCount + OverrideOrComputed(overrides, "podcasts-count", podcastCount)
            - tiktokVideos + OverrideOrComputed(overrides, "tiktok-videos", tiktokVideos)
            - bilibiliVideos + OverrideOrComputed(overrides, "bilibili-videos", bilibiliVideos)
            - instagramReels + OverrideOrComputed(overrides, "instagram-reels", instagramReels);
        totalCoverages = OverrideOrComputed(overrides, "media-coverages", totalCoverages);

        MediaCoverageStatCard Card(
            string id, string value, string label, string hint, bool featured, string platform = "")
        {
            var metricId = MediaCoverageCardOverrideIds.TryGetValue(id, out var mapped) ? mapped : id;
            if (overrides.TryGetValue(metricId, out var overrideValue)
                && !string.IsNullOrWhiteSpace(overrideValue))
            {
                return new(id, overrideValue.Trim(), label, hint, featured, platform, true);
            }
            return new(id, value, label, hint, featured, platform, false);
        }

        return
        [
            Card("total-audience", Format(totalAudience), "Total Audience", "Total sub & follower count", true, "audience"),
            Card("media-coverages", Format(totalCoverages), "Media Coverages", "All types of coverages", true, "coverages"),
            Card("audience-youtube", Format(youtubeAudience), "Audience YouTube", "Total subscriber count", false, "youtube"),
            Card("coverages-youtube", Format(youtube.Count), "Media Coverages YouTube", "Pieces of content", false, "youtube"),
            Card("creators-youtube", Format(CountMediaCoverageCreators(youtube)), "Individual Influencer Contribution YouTube", "Total number of different creators", false, "youtube"),
            Card("views-youtube", Format(SumMediaCoverageField(youtube, "youtubeViews")), "YouTube Views", "Total number of views", false, "youtube"),
            Card("likes-youtube", Format(SumMediaCoverageField(youtube, "youtubeLikes")), "YouTube Likes", "Total number of likes", false, "youtube"),
            Card("comments-youtube", Format(SumMediaCoverageField(youtube, "youtubeComments")), "YouTube Comments", "Total number of comments", false, "youtube"),
            Card("videos-tiktok", Format(tiktok.Count), "TikTok Videos", "Total number of videos", false, "tiktok"),
            Card("creators-tiktok", Format(CountMediaCoverageCreators(tiktok)), "Individual Influencer Contribution TikTok", "Total number of different creators", false, "tiktok"),
            Card("views-tiktok", Format(SumMediaCoverageField(tiktok, "tiktokViews")), "TikTok Views", "Total number views on TikTok", false, "tiktok"),
            Card("likes-tiktok", Format(SumMediaCoverageField(tiktok, "tiktokLikes")), "TikTok Likes", "Total number of likes on TikTok", false, "tiktok"),
            Card("reels-instagram", Format(instagram.Count), "Instagram Reels", "Total number of reels", false, "instagram"),
            Card("creators-instagram", Format(CountMediaCoverageCreators(instagram)), "Individual Influencer Contribution Instagram", "Total number of different creators", false, "instagram"),
            Card("views-instagram", Format(SumMediaCoverageField(instagram, "instagramViews")), "Instagram Views", "Total number views on Instagram", false, "instagram"),
            Card("likes-instagram", Format(SumMediaCoverageField(instagram, "instagramLikes")), "Instagram Likes", "Total number of likes on Instagram", false, "instagram"),
            Card("comments-instagram", Format(SumMediaCoverageField(instagram, "instagramComments")), "Instagram Comments", "Total number of comments on Instagram", false, "instagram"),
            Card("videos-bilibili", Format(bilibili.Count), "BiliBili Videos", "Total number of videos", false, "bilibili"),
            Card("creators-bilibili", Format(CountMediaCoverageCreators(bilibili)), "Individual Influencer Contribution BiliBili", "Total number of different creators", false, "bilibili"),
            Card("views-bilibili", Format(SumMediaCoverageField(bilibili, "bilibiliViews")), "BiliBili Views", "Total number views on BiliBili", false, "bilibili"),
            Card("likes-bilibili", Format(SumMediaCoverageField(bilibili, "bilibiliLikes")), "BiliBili Likes", "Total number of likes on BiliBili", false, "bilibili"),
            Card("comments-bilibili", Format(SumMediaCoverageField(bilibili, "bilibiliComments")), "BiliBili Comments", "Total number of comments on BiliBili", false, "bilibili"),
            Card("podcasts", Format(podcasts.Count), "Podcasts", "Total number of podcasts", false, "podcast"),
        ];
    }

