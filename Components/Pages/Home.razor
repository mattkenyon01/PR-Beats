    private void OnCoverImageError()
    {
        if (_slides.Count == 0) return;
        var activeRow = _slides[_activeIndex];
        var gameTitle = string.IsNullOrWhiteSpace(activeRow.GameTitle)
            ? "Untitled"
            : activeRow.GameTitle.Trim();
        var url = GameImageForTitle(gameTitle);
        if (string.IsNullOrWhiteSpace(url))
            url = activeRow.GameImage?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(url)) return;
        if (string.Equals(_coverLoadAttemptUrl, url, StringComparison.Ordinal))
            return;
        _coverLoadAttemptUrl = url;
        var shortUrl = url.Length > 120 ? url[..117] + "…" : url;
        _coverLoadError =
            $"Cover image URL failed to load for “{gameTitle}”. " +
            $"Browser could not fetch: {shortUrl}. " +
            "Check the URL is reachable from this page (Worker / R2), or re-upload in Admin.";
    }

    private string GameImageForTitle(string gameTitle)
    {
        var key = string.IsNullOrWhiteSpace(gameTitle) ? "Untitled" : gameTitle.Trim();
        foreach (var row in _slides)
        {
            var title = string.IsNullOrWhiteSpace(row.GameTitle)
                ? "Untitled"
                : row.GameTitle.Trim();
            if (!string.Equals(title, key, StringComparison.OrdinalIgnoreCase))
                continue;
            var image = row.GameImage?.Trim() ?? "";
            if (!string.IsNullOrWhiteSpace(image))
                return image;
        }
        return "";
    }

    private void OpenPdfViewer(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return;
        _pdfViewerUrl = url;
        _pdfViewerOpen = true;
    }

    private void ClosePdfViewer()
    {
        _pdfViewerOpen = false;
        _pdfViewerUrl = null;
    }

    private void OnPdfViewerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") ClosePdfViewer();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (_pdfViewerOpen)
        {
            if (e.Key == "Escape") ClosePdfViewer();
            return;
        }
        if (e.Key == "ArrowRight") _ = ShowSlide(_activeIndex + 1);
        else if (e.Key == "ArrowLeft") _ = ShowSlide(_activeIndex - 1);
    }

    private void OnTouchStart(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length > 0)
            _touchStartX = e.ChangedTouches[0].ClientX;
    }

    private void OnTouchEnd(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length == 0) return;
        var delta = e.ChangedTouches[0].ClientX - _touchStartX;
        if (Math.Abs(delta) < 40) return;
        _ = ShowSlide(_activeIndex + (delta < 0 ? 1 : -1));
    }

