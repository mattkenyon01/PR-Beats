{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prbeats",
  "main": "src/prbeats.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  // After: npx wrangler d1 create prbeats-db
  // paste the database_id below and remove this comment block's placeholders.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prbeats-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // After: npx wrangler r2 bucket create prbeats-images
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "prbeats-images"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "prbeats-996dd"
  },
  // Put your static site files in ./public then deploy.
  // Copy from the repo root: index.html, login.html, admin.html, styles.css,
  // firebase-config.js, js/, images/
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API must hit the Worker, not the static asset server (otherwise PUT/POST → 405)
    "run_worker_first": ["/api/*"]
  }
}
