{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "prbeats",
	"main": "src/prbeats.js",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pr-beats-database",
			"database_id": "e51acf08-f0be-4a64-9822-43493e2902b0",
			"migrations_dir": "migrations"
		}
	],
	// Existing bucket with uploaded covers (not the empty prbeats-images created later)
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "prbeatsimages"
		}
	],
	"vars": {
		"FIREBASE_PROJECT_ID": "prbeats-996dd"
	},
	// Put your static site files in ./public then deploy.
	// Copy from the repo root: index.html, login.html, admin.html, styles.css,
	// firebase-config.js, js/, images/
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// API must hit the Worker, not the static asset server (otherwise PUT/POST → 405)
		"run_worker_first": [
			"/api/*"
		]
	}
}